{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "rm": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "unlink *": "deny",
      "shred *": "deny",
      "find * -delete*": "deny",
      "find * -exec rm*": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout -- *": "deny",
      "git checkout .": "deny",
      "git restore*": "deny",
      "git rebase*": "deny",
      "git filter-branch*": "deny",
      "git branch -D*": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "git commit -n*": "deny",
      "*--no-verify*": "deny",
      "sudo *": "deny",
      "dd *": "deny",
      "mkfs*": "deny"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "git status*": "allow",
          "git ls-files*": "allow",
          "ls*": "allow"
        }
      }
    }
  }
}
